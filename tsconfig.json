{
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "allowJs": true,
    "allowImportingTsExtensions": false,
    "checkJs": false,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2020"
  },
  "include": ["src/**/*.ts"],
  "exclude": [".rive", "build", "coverage", "dist", "node_modules", "src/**/*.test.ts"]
}
